      "@id": "kt:voyager",
      "@type": "kto:Model",
      "skos:prefLabel": "Voyager (embodied LLM agent)",
      "skos:definition": "An LLM-powered lifelong-learning agent for Minecraft, introduced in 2023 by researchers at NVIDIA and partner universities, that proposes its own tasks, writes executable code to accomplish them, and stores verified programs in a growing skill library it can retrieve and reuse, all through black-box GPT-4 calls with no fine-tuning.",
      "kto:domain": "agents-and-tool-use",
      "dcterms:created": "2026-11-10",
      "kto:maturity": "emerging",
      "prov:wasDerivedFrom": [
