      "@id": "kt:clip",
      "@type": "kto:Model",
      "skos:prefLabel": "CLIP",
      "skos:definition": "A dual-encoder vision-language model from OpenAI (2021) that trains an image encoder and a text encoder jointly with a contrastive objective on hundreds of millions of web image-caption pairs, so that images and text share one embedding space and new visual categories can be recognized zero-shot from natural-language descriptions.",
      "kto:domain": "computer-vision-and-multimodal",
      "dcterms:created": "2026-11-09",
      "kto:maturity": "established",
