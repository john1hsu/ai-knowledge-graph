    {
      "@id": "kt:an-image-is-worth-16x16-words",
      "@type": "kto:Work",
      "skos:prefLabel": "An Image Is Worth 16x16 Words: Transformers for Image Recognition at Scale",
      "skos:definition": "The ICLR 2021 paper by Dosovitskiy and eleven Google Research colleagues that introduced the Vision Transformer (ViT): it cuts an image into fixed-size patches, embeds each patch as a token and feeds the sequence to a nearly unmodified Transformer encoder, showing that with enough pre-training data this convolution-free model matches or beats state-of-the-art CNNs at lower pre-training compute.",
      "kto:domain": "computer-vision-and-multimodal",
      "dcterms:created": "2026-11-10",
      "kto:maturity": "foundational",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "An Image is Worth 16x16 Words: Transformers for Image Recognition at Scale (oral)",
          "dcterms:publisher": "Dosovitskiy, Beyer, Kolesnikov, Weissenborn, Zhai, Unterthiner, Dehghani, Minderer, Heigold, Gelly, Uszkoreit and Houlsby, ICLR 2021 virtual conference page",
