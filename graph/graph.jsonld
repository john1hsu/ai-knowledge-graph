      "@id": "kt:double-descent",
      "@type": "kto:Concept",
      "skos:prefLabel": "Double descent",
      "skos:definition": "The empirical and theoretical finding that test error, as model capacity, training time or sample size grows, can first fall, then rise to a peak where the model just barely fits the training data (the interpolation threshold), and then fall again in the over-parameterized regime.",
      "kto:domain": "ml-foundations",
      "dcterms:created": "2026-11-09",
      "kto:maturity": "established",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Reconciling modern machine learning practice and the bias-variance trade-off",
          "dcterms:publisher": "arXiv:1812.11118 (Belkin, Hsu, Ma, Mandal), 2018; v2 2019; published in PNAS, doi 10.1073/pnas.1903070116",
          "schema:url": "https://arxiv.org/pdf/1812.11118",
          "kto:sourceType": "primary"
        },
        {
          "dcterms:title": "Deep Double Descent: Where Bigger Models and More Data Hurt",
          "dcterms:publisher": "ICLR 2020 (Nakkiran, Kaplun, Bansal, Yang, Barak, Sutskever)",
          "schema:url": "https://mlanthology.org/iclr/2020/nakkiran2020iclr-deep",
          "kto:sourceType": "peer-reviewed"
        },
        {
          "dcterms:title": "Deep Double Descent: Where Bigger Models and More Data Hurt (authors' version)",
