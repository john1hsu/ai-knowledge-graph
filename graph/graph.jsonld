    {
      "@id": "kt:toolformer",
      "@type": "kto:Model",
      "skos:prefLabel": "Toolformer: Language Models Can Teach Themselves to Use Tools",
      "skos:definition": "A 2023 Meta AI method and model in which a language model (GPT-J, 6.7B parameters) annotates its own training text with candidate API calls, keeps only the calls whose results make the following tokens easier to predict, and is fine-tuned on the result, so it learns by self-supervision when and how to call a calculator, QA system, search engine, translator and calendar.",
      "kto:domain": "agents-and-tool-use",
      "dcterms:created": "2026-11-10",
