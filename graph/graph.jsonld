    {
      "@id": "kt:large-language-model",
      "@type": "kto:Concept",
      "skos:prefLabel": "Large language model",
      "skos:definition": "A neural language model, almost always a transformer, with billions of parameters that is pretrained on very large text corpora to predict the next token and can then be prompted or adapted to perform a wide range of language tasks.",
      "kto:domain": "transformers-and-llms",
      "dcterms:created": "2026-10-30",
      "kto:maturity": "established",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Speech and Language Processing (3rd ed. draft), Chapter 7: Transformers and Pretraining",
          "dcterms:publisher": "D. Jurafsky and J. H. Martin, Stanford University (draft of August 2026)",
          "schema:url": "https://web.stanford.edu/~jurafsky/slp3/7.pdf",
          "kto:sourceType": "textbook"
        },
        {
          "dcterms:title": "Language Models are Few-Shot Learners",
          "dcterms:publisher": "Brown et al. (OpenAI), NeurIPS 2020",
          "schema:url": "https://papers.neurips.cc/paper/2020/hash/1457c0d6bfcb4967418bfb8ac142f64a-Abstract.html",
          "kto:sourceType": "peer-reviewed"
        },
