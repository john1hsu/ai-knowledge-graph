    {
      "@id": "kt:chain-of-thought",
      "@type": "kto:Technique",
      "skos:prefLabel": "Chain-of-thought prompting",
      "skos:definition": "A prompting technique in which a language model is led to write out a sequence of intermediate natural-language reasoning steps before giving its final answer, which improves accuracy on multi-step arithmetic, commonsense and symbolic reasoning tasks in sufficiently large models.",
      "kto:domain": "prompting-and-reasoning",
      "dcterms:created": "2026-10-31",
      "kto:maturity": "established",
      "prov:wasDerivedFrom": [
