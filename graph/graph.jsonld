    {
      "@id": "kt:expert-systems",
      "@type": "kto:Paradigm",
      "skos:prefLabel": "Expert systems",
      "skos:definition": "Symbolic AI programs that capture the knowledge of human specialists in a narrow domain, usually as if-then production rules in a knowledge base, and apply it through a separate inference engine; pioneered at Stanford with DENDRAL (from 1965) and MYCIN (from 1972), they were the first commercially significant form of AI.",
      "kto:domain": "ai-history",
      "dcterms:created": "2026-11-13",
      "kto:maturity": "historical",
