      "dcterms:created": "2026-10-31",
      "kto:maturity": "foundational",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Some Studies in Machine Learning Using the Game of Checkers",
          "dcterms:publisher": "IBM Journal of Research and Development 3(3), 210–229 (1959) (Arthur L. Samuel), ML Anthology record",
          "schema:url": "https://mlanthology.org/misc/1959/samuel1959misc-some",
          "kto:sourceType": "peer-reviewed"
        },
