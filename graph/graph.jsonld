    {
      "@id": "kt:exploration-exploitation",
      "@type": "kto:Concept",
      "skos:prefLabel": "Exploration-exploitation dilemma",
      "skos:definition": "The tension faced by any agent that learns from its own actions: it must exploit the action that currently looks best to collect reward, yet also explore less-tried actions whose value is uncertain and might turn out to be higher.",
      "kto:domain": "reinforcement-learning",
      "dcterms:created": "2026-11-11",
      "kto:maturity": "foundational",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Reinforcement Learning: An Introduction (2nd ed.)",
          "dcterms:publisher": "MIT Press, 2018 (Sutton and Barto), course copy hosted by Texas A&M CSCE 421",
          "schema:url": "https://people.engr.tamu.edu/guni/csce421/files/RLbook2018.pdf",
          "kto:sourceType": "textbook"
        },
        {
          "dcterms:title": "Finite-time Analysis of the Multiarmed Bandit Problem",
          "dcterms:publisher": "Machine Learning 47:235-256, 2002 (Auer, Cesa-Bianchi and Fischer)",
          "schema:url": "https://homes.di.unimi.it/%7Ecesabian/Pubblicazioni/ml-02.pdf",
          "kto:sourceType": "peer-reviewed"
        },
        {
          "dcterms:title": "A Tutorial on Thompson Sampling",
          "dcterms:publisher": "arXiv 1707.02038 (Russo, Van Roy, Kazerouni, Osband and Wen)",
          "schema:url": "https://arxiv.org/abs/1707.02038v3",
          "kto:sourceType": "primary"
        },
        {
          "dcterms:title": "Unifying Count-Based Exploration and Intrinsic Motivation",
