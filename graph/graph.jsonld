          "schema:url": "https://www.rand.org/pubs/papers/P868.html",
          "kto:sourceType": "primary"
        },
        {
          "dcterms:title": "Early Heuristic Programs (ch. 5 of The Quest for Artificial Intelligence)",
          "dcterms:publisher": "N. J. Nilsson, Cambridge University Press, 2009 (doi:10.1017/CBO9780511819346.007)",
          "schema:url": "https://www.cambridge.org/core/books/abs/quest-for-artificial-intelligence/early-heuristic-programs/2E2E2219739947C7868D9A68C49A49D1",
          "kto:sourceType": "textbook"
        },
        {
          "dcterms:title": "Allen Newell",
