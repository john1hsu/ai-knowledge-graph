    {
      "@id": "kt:agent2agent-protocol",
      "@type": "kto:Tool",
      "skos:prefLabel": "Agent2Agent protocol",
      "skos:definition": "An open protocol, launched by Google in April 2025 and now governed under the Linux Foundation, that lets independent AI agents built on different frameworks discover one another through published Agent Cards and delegate, track and complete tasks as peers without sharing their internal memory, tools or prompts.",
      "kto:domain": "agents-and-tool-use",
      "dcterms:created": "2026-11-09",
      "kto:maturity": "emerging",
      "prov:wasDerivedFrom": [
        {
