    {
      "@id": "kt:quantization",
      "@type": "kto:Technique",
      "skos:prefLabel": "Quantization",
      "skos:definition": "A model-compression technique that represents a neural network's weights (and often its activations) with low-precision numbers such as 8-bit or 4-bit integers or 8/4-bit floats instead of 16- or 32-bit floats, cutting memory and bandwidth and enabling faster integer or low-precision arithmetic at a small cost in accuracy.",
      "kto:domain": "inference-and-optimization",
      "dcterms:created": "2026-10-31",
      "kto:maturity": "established",
