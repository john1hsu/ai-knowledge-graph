      "@id": "kt:turing-test",
      "@type": "kto:Concept",
      "skos:prefLabel": "Turing test",
      "skos:definition": "A behavioural test proposed by Alan Turing in 1950 in which a human interrogator converses by text with a hidden human and a hidden machine and tries to tell which is which; the machine does well if it is mistaken for the human about as often as not.",
      "kto:domain": "ai-history",
      "dcterms:created": "2026-10-30",
      "kto:maturity": "foundational",
      "prov:wasDerivedFrom": [
        {
