    {
      "@id": "kt:star-self-taught-reasoner",
      "@type": "kto:Technique",
      "skos:prefLabel": "STaR: Self-Taught Reasoner",
      "skos:definition": "An iterative self-training method in which a language model generates step-by-step rationales for training questions, keeps only those that reach the correct answer (retrying with the answer as a hint when it fails), and is fine-tuned on them, so its reasoning improves without a large human-written rationale dataset.",
      "kto:domain": "training-and-adaptation",
      "dcterms:created": "2026-11-10",
      "kto:maturity": "established",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "STaR: Bootstrapping Reasoning With Reasoning",
          "dcterms:publisher": "Advances in Neural Information Processing Systems 35 (NeurIPS 2022), Zelikman, Wu, Mu and Goodman",
          "schema:url": "https://proceedings.neurips.cc/paper_files/paper/2022/hash/639a9a172c044fbb64175b5fad42e9a5-Abstract-Conference.html",
          "kto:sourceType": "peer-reviewed"
        },
