    {
      "@id": "kt:logic-theorist",
      "@type": "kto:Model",
      "skos:prefLabel": "Logic Theorist",
      "skos:definition": "A 1955–1957 computer program by Allen Newell, J. C. (Cliff) Shaw and Herbert A. Simon at RAND that searched for proofs of propositional-logic theorems from Whitehead and Russell's Principia Mathematica using heuristic methods modelled on human problem solving; it is widely regarded as the first artificial intelligence program.",
      "kto:domain": "ai-history",
      "dcterms:created": "2026-11-12",
      "kto:maturity": "historical",
      "prov:wasDerivedFrom": [
