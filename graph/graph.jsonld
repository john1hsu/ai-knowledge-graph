    {
      "@id": "kt:artificial-neural-network",
      "@type": "kto:Architecture",
      "skos:prefLabel": "Artificial neural network",
      "skos:definition": "A computational model built from many simple, interconnected units (\"neurons\") that each combine weighted inputs and apply a nonlinear function, with the connection weights learned from data so that the network as a whole computes a useful function of its input.",
      "kto:domain": "deep-learning",
      "dcterms:created": "2026-10-30",
      "kto:maturity": "foundational",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "A logical calculus of the ideas immanent in nervous activity",
          "dcterms:publisher": "The Bulletin of Mathematical Biophysics 5, 115–133 (1943) (McCulloch and Pitts)",
          "schema:url": "https://link.springer.com/doi/10.1007/BF02478259",
          "kto:sourceType": "peer-reviewed"
        },
        {
          "dcterms:title": "The perceptron: A probabilistic model for information storage and organization in the brain",
          "dcterms:publisher": "Psychological Review 65(6), 386–408 (1958) (Rosenblatt), author's paper hosted by UIC",
