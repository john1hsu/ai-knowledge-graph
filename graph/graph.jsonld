      "@id": "kt:self-consistency",
      "@type": "kto:Technique",
      "skos:prefLabel": "Self-consistency",
      "skos:definition": "A decoding strategy for chain-of-thought prompting that samples many independent reasoning paths from a language model and returns the final answer that the largest number of paths agree on, instead of trusting a single greedily decoded chain.",
      "kto:domain": "prompting-and-reasoning",
      "dcterms:created": "2026-11-08",
      "kto:maturity": "established",
      "prov:wasDerivedFrom": [
        {
