          "dcterms:publisher": "Nature 323, 533–536 (1986) (Rumelhart, Hinton and Williams), NASA ADS record",
          "schema:url": "https://ui.adsabs.harvard.edu/abs/1986Natur.323..533R/abstract",
          "kto:sourceType": "peer-reviewed"
        },
        {
          "dcterms:title": "Dive into Deep Learning: Multilayer Perceptron",
