    {
      "@id": "kt:cuda",
      "@type": "kto:Tool",
      "skos:prefLabel": "CUDA",
      "skos:definition": "NVIDIA's parallel computing platform and programming model for general-purpose computation on its GPUs, in which a host program launches kernels executed by a hierarchy of thousands of lightweight threads; it is the software layer beneath most deep-learning training and inference.",
      "kto:domain": "ai-infrastructure-and-mlops",
      "dcterms:created": "2026-11-08",
      "kto:maturity": "established",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "CUDA Programming Guide, 1.2 Programming Model (v13.4.2)",
          "dcterms:publisher": "NVIDIA CUDA documentation",
          "schema:url": "https://docs.nvidia.com/cuda/cuda-programming-guide/01-introduction/programming-model.html",
          "kto:sourceType": "official-docs"
        },
        {
          "dcterms:title": "Scalable Parallel Programming with CUDA",
          "dcterms:publisher": "ACM Queue 6(2), March 2008 (Nickolls, Buck, Garland, Skadron); course copy",
          "schema:url": "https://grothoff.org/christian/teaching/2008/4704/scalable_cuda.pdf",
          "kto:sourceType": "primary"
        },
        {
          "dcterms:title": "cuDNN: Efficient Primitives for Deep Learning",
