    {
      "@id": "kt:activation-function",
      "@type": "kto:Concept",
      "skos:prefLabel": "Activation function",
      "skos:definition": "The elementwise nonlinear function a neural network applies to each unit's weighted input sum (for example sigmoid, tanh, ReLU, GELU or Swish); without it, any stack of layers collapses into a single linear map, so the choice of activation decides both what a network can represent and how easily gradients flow during training.",
      "kto:domain": "deep-learning",
      "dcterms:created": "2026-11-13",
      "kto:maturity": "foundational",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "5.1. Multilayer Perceptrons (Dive into Deep Learning)",
          "dcterms:publisher": "Zhang, Lipton, Li and Smola, Dive into Deep Learning (d2l.ai)",
          "schema:url": "https://d2l.ai/chapter_multilayer-perceptrons/mlp.html",
          "kto:sourceType": "textbook"
        },
        {
          "dcterms:title": "Rectified Linear Units Improve Restricted Boltzmann Machines",
          "dcterms:publisher": "ICML 2010, pp. 807–814 (Nair and Hinton), via ML Anthology",
          "schema:url": "https://mlanthology.org/icml/2010/nair2010icml-rectified",
          "kto:sourceType": "peer-reviewed"
        },
