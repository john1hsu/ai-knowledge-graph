    {
      "@id": "kt:algorithmic-bias-and-fairness",
      "@type": "kto:Risk",
      "skos:prefLabel": "Algorithmic bias and fairness",
      "skos:definition": "Algorithmic bias is systematic, unjustified disparity in how an automated or machine-learning system treats or performs for different groups of people; algorithmic fairness is the study of formal criteria, measurements and interventions for detecting and reducing such disparities, together with the trade-offs between them.",
      "kto:domain": "governance-and-policy",
      "dcterms:created": "2026-11-09",
      "kto:maturity": "established",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Fairness and Machine Learning: Limitations and Opportunities — Chapter 3, Classification",
          "dcterms:publisher": "MIT Press, 2023 (Barocas, Hardt, Narayanan); online edition at fairmlbook.org",
          "schema:url": "https://fairmlbook.org/classification.html",
          "kto:sourceType": "textbook"
        },
        {
          "dcterms:title": "Equality of Opportunity in Supervised Learning",
          "dcterms:publisher": "NeurIPS 2016 (Hardt, Price, Srebro)",
          "schema:url": "https://papers.nips.cc/paper/2016/file/9d2682367c3935defcb1f9e247a97c0d-Paper.pdf",
          "kto:sourceType": "peer-reviewed"
        },
        {
          "dcterms:title": "Inherent Trade-Offs in the Fair Determination of Risk Scores",
          "dcterms:publisher": "ITCS 2017, LIPIcs vol. 67 (Kleinberg, Mullainathan, Raghavan)",
          "schema:url": "https://drops.dagstuhl.de/opus/volltexte/2017/8156/pdf/LIPIcs-ITCS-2017-43.pdf",
          "kto:sourceType": "peer-reviewed"
        },
        {
          "dcterms:title": "Gender Shades: Intersectional Accuracy Disparities in Commercial Gender Classification",
          "dcterms:publisher": "Proceedings of the 1st Conference on Fairness, Accountability and Transparency, PMLR 81 (Buolamwini, Gebru), 2018",
          "schema:url": "https://proceedings.mlr.press/v81/buolamwini18a.html",
          "kto:sourceType": "peer-reviewed"
        },
