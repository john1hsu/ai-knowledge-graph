      "@id": "kt:perceptron",
      "@type": "kto:Algorithm",
      "skos:prefLabel": "Perceptron",
      "skos:definition": "Frank Rosenblatt's 1958 learning machine and the error-driven rule behind it: a single layer of adjustable weights that classifies inputs by the sign of a weighted sum and nudges the weights toward each misclassified example, guaranteed to converge when the classes are linearly separable.",
      "kto:domain": "ai-history",
      "dcterms:created": "2026-11-10",
      "kto:maturity": "foundational",
      "prov:wasDerivedFrom": [
