          "dcterms:publisher": "Y. Freund and R. E. Schapire, Machine Learning 37(3), 277–296, 1999 (copy hosted by Princeton COS 402)",
          "schema:url": "https://www.cs.princeton.edu/courses/archive/fall08/cos402/readings/voted-perceptron.pdf",
