      "@id": "kt:embeddings",
      "@type": "kto:Concept",
      "skos:prefLabel": "Embeddings",
      "skos:definition": "Learned, dense, fixed-length vectors of real numbers that represent discrete items such as words, sentences, documents or images, arranged so that geometric closeness (for example, high cosine similarity) reflects semantic or functional similarity.",
      "kto:domain": "retrieval-and-knowledge",
      "dcterms:created": "2026-10-31",
      "kto:maturity": "established",
      "prov:wasDerivedFrom": [
        {
