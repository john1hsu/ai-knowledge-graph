      "@id": "kt:tf-idf",
      "@type": "kto:Technique",
      "skos:prefLabel": "TF-IDF",
      "skos:definition": "A term-weighting scheme that scores a word's importance to a document by multiplying how often it occurs in that document (term frequency) by the logarithm of how rare it is across the collection (inverse document frequency), so frequent-but-distinctive words dominate a document's vector.",
      "kto:domain": "retrieval-and-knowledge",
      "dcterms:created": "2026-11-09",
      "kto:maturity": "foundational",
