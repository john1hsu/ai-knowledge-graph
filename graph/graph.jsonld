    {
      "@id": "kt:markov-decision-process",
      "@type": "kto:Concept",
      "skos:prefLabel": "Markov decision process",
      "skos:definition": "The standard mathematical model of sequential decision-making under uncertainty: an agent in a state chooses an action, the environment returns a reward and a next state drawn from probabilities that depend only on the current state and action, and the goal is a policy that maximises expected (discounted) return.",
      "kto:domain": "reinforcement-learning",
      "dcterms:created": "2026-11-12",
      "kto:maturity": "foundational",
      "prov:wasDerivedFrom": [
