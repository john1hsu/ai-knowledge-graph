    {
      "@id": "kt:turing-test",
      "@type": "kto:Concept",
      "skos:prefLabel": "Turing test",
      "skos:definition": "A behavioural test proposed by Alan Turing in 1950 in which a human interrogator converses by text with a hidden human and a hidden machine and tries to tell which is which; the machine does well if it is mistaken for the human about as often as not.",
      "kto:domain": "ai-history",
      "dcterms:created": "2026-10-30",
      "kto:maturity": "foundational",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Computing Machinery and Intelligence",
          "dcterms:publisher": "A. M. Turing, Mind 59 (236), 1950 (copy hosted for MIT CSAIL course 6.803)",
          "schema:url": "https://courses.csail.mit.edu/6.803/pdf/turing.pdf",
          "kto:sourceType": "primary"
        },
        {
          "dcterms:title": "The Turing Test (Summer 2006 edition)",
          "dcterms:publisher": "Stanford Encyclopedia of Philosophy",
          "schema:url": "https://plato.stanford.edu/archives/sum2006/entries/turing-test/",
          "kto:sourceType": "academic"
        },
        {
          "dcterms:title": "Turing test",
          "dcterms:publisher": "Encyclopaedia Britannica",
          "schema:url": "https://www.britannica.com/topic/Turing-test",
          "kto:sourceType": "encyclopedia"
        },
        {
          "dcterms:title": "Large Language Models Pass the Turing Test",
          "dcterms:publisher": "Jones and Bergen, UC San Diego, arXiv 2503.23674 (authors' version)",
          "schema:url": "https://arxiv.org/abs/2503.23674v1",
          "kto:sourceType": "primary"
        }
      ],
      "kto:file": "articles/ai-history/turing-test.md",
