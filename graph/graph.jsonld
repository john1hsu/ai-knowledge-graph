          "dcterms:publisher": "MIT 6.390 Intro to Machine Learning (Shen Shen), April 2026",
          "schema:url": "https://introml.mit.edu/_static/spring26/lectures/lec10/lecture10.pdf",
          "kto:sourceType": "academic"
        },
        {
