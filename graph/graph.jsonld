      "@id": "kt:emergent-abilities",
      "@type": "kto:Concept",
      "skos:prefLabel": "Emergent abilities",
      "skos:definition": "Capabilities that are absent (near chance) in smaller language models but present in larger ones, so that they cannot be forecast by extrapolating the performance of smaller models; whether such jumps are real or an artifact of evaluation metrics is actively debated.",
      "kto:domain": "transformers-and-llms",
      "dcterms:created": "2026-11-09",
      "kto:maturity": "emerging",
