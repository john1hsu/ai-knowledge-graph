    {
      "@id": "kt:flash-attention",
      "@type": "kto:Algorithm",
      "skos:prefLabel": "FlashAttention: Fast and Memory-Efficient Exact Attention with IO-Awareness",
      "skos:definition": "A family of IO-aware GPU kernels that compute exact softmax attention by tiling queries, keys and values through fast on-chip SRAM with an online softmax, so the full sequence-by-sequence attention matrix is never written to slow high-bandwidth memory; it cuts attention memory to linear in sequence length and speeds up both training and inference.",
      "kto:domain": "inference-and-optimization",
      "dcterms:created": "2026-11-11",
      "kto:maturity": "established",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "FlashAttention: Fast and Memory-Efficient Exact Attention with IO-Awareness",
