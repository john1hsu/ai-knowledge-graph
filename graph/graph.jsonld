    {
      "@id": "kt:chinese-room-argument",
      "@type": "kto:Concept",
      "skos:prefLabel": "Chinese room argument",
      "skos:definition": "A thought experiment published by philosopher John Searle in 1980 arguing that running a program, however convincing its outputs, is not by itself sufficient for understanding, because symbol manipulation is purely syntactic while minds have semantic content.",
      "kto:domain": "ai-history",
      "dcterms:created": "2026-10-30",
      "kto:maturity": "foundational",
      "prov:wasDerivedFrom": [
        {
