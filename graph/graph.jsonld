          "schema:url": "https://mlanthology.org/misc/1943/mcculloch1943misc-logical",
          "kto:sourceType": "peer-reviewed"
        },
        {
          "dcterms:title": "A Logical Calculus of the Ideas Immanent in Nervous Activity (full text)",
          "dcterms:publisher": "McCulloch and Pitts, 1943; copy hosted for a University of Illinois ECE course",
          "schema:url": "https://jontallen.ece.illinois.edu/uploads/498-NS.S21/McCulloch-Pitts-1943-neural-networks-ocr.pdf",
          "kto:sourceType": "primary"
        },
