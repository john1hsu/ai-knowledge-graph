    {
      "@id": "kt:diffusion-model",
      "@type": "kto:Architecture",
      "skos:prefLabel": "Diffusion model",
      "skos:definition": "A class of generative models that learns to reverse a gradual noising process: data are progressively corrupted with Gaussian noise, and a neural network is trained to denoise step by step, so that new samples can be generated by starting from pure noise and iteratively removing it.",
      "kto:domain": "computer-vision-and-multimodal",
      "dcterms:created": "2026-10-30",
      "kto:maturity": "established",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Deep Unsupervised Learning using Nonequilibrium Thermodynamics",
          "dcterms:publisher": "Sohl-Dickstein, Weiss, Maheswaranathan and Ganguli, Proceedings of ICML 2015 (PMLR 37), pp. 2256–2265",
          "schema:url": "https://proceedings.mlr.press/v37/sohl-dickstein15.html",
          "kto:sourceType": "peer-reviewed"
        },
        {
          "dcterms:title": "Denoising Diffusion Probabilistic Models",
          "dcterms:publisher": "Ho, Jain and Abbeel, NeurIPS 2020 (authors' arXiv version, 2006.11239v2)",
          "schema:url": "https://arxiv.org/pdf/2006.11239v2",
          "kto:sourceType": "primary"
        },
        {
          "dcterms:title": "Score-based generative modeling through stochastic differential equations",
          "dcterms:publisher": "Song, Sohl-Dickstein, Kingma, Kumar, Ermon and Poole, ICLR 2021 (Google Research publication page)",
          "schema:url": "https://research.google/pubs/score-based-generative-modeling-through-stochastic-differential-equations/",
          "kto:sourceType": "lab-research"
        },
        {
          "dcterms:title": "High-Resolution Image Synthesis With Latent Diffusion Models",
          "dcterms:publisher": "Rombach, Blattmann, Lorenz, Esser and Ommer, CVPR 2022, pp. 10684–10695",
          "schema:url": "https://openaccess.thecvf.com/content/CVPR2022/html/Rombach_High-Resolution_Image_Synthesis_With_Latent_Diffusion_Models_CVPR_2022_paper.html",
          "kto:sourceType": "peer-reviewed"
