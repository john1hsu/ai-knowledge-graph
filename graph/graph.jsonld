    {
      "@id": "kt:ai-agent",
      "@type": "kto:Concept",
      "skos:prefLabel": "AI agent",
      "skos:definition": "A system that perceives its environment and acts on it to achieve goals; in current usage, usually a large language model that decides its own sequence of steps and tool calls in a loop driven by feedback from the environment.",
      "kto:domain": "agents-and-tool-use",
      "dcterms:created": "2026-10-30",
      "kto:maturity": "emerging",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Chapter 2: Intelligent Agents (CMSC 421 lecture slides, after Russell & Norvig, AIMA)",
          "dcterms:publisher": "University of Maryland, Department of Computer Science",
