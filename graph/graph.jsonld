    {
      "@id": "kt:bias-variance-tradeoff",
      "@type": "kto:Concept",
      "skos:prefLabel": "Bias-variance tradeoff",
      "skos:definition": "The tension between a learner's systematic error (bias) and its sensitivity to the particular training sample (variance), formalised by decomposing expected squared test error into bias squared, variance and irreducible noise; it explains underfitting and overfitting and guides choices of model complexity.",
      "kto:domain": "ml-foundations",
      "dcterms:created": "2026-10-31",
      "kto:maturity": "foundational",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Neural Networks and the Bias/Variance Dilemma",
          "dcterms:publisher": "Neural Computation 4, 1–58 (1992) (Geman, Bienenstock and Doursat), ML Anthology record",
          "schema:url": "https://mlanthology.org/neco/1992/geman1992neco-neural",
          "kto:sourceType": "peer-reviewed"
