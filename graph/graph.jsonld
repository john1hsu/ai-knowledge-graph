    {
      "@id": "kt:react-prompting",
      "@type": "kto:Technique",
      "skos:prefLabel": "ReAct prompting",
      "skos:definition": "A prompting paradigm, introduced by Yao et al. (Google Research, ICLR 2023), in which a language model interleaves free-form reasoning traces (\"thoughts\") with actions such as search or tool calls and reads back the resulting observations, so reasoning guides actions and external feedback grounds reasoning.",
      "kto:domain": "agents-and-tool-use",
      "dcterms:created": "2026-11-13",
      "kto:maturity": "established",
      "prov:wasDerivedFrom": [
