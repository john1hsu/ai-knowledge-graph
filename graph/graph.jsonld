    {
      "@id": "kt:imagenet-and-alexnet",
      "@type": "kto:Event",
      "skos:prefLabel": "ImageNet and AlexNet",
      "skos:definition": "The 2012 turning point when AlexNet, a GPU-trained deep convolutional network by Krizhevsky, Sutskever and Hinton, won the ImageNet Large Scale Visual Recognition Challenge with a 15.3% top-5 error against 26.2% for the runner-up, showing that features learned from a very large labeled dataset could beat hand-engineered vision pipelines.",
      "kto:domain": "ai-history",
