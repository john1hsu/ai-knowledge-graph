    {
      "@id": "kt:overfitting",
      "@type": "kto:Concept",
      "skos:prefLabel": "Overfitting",
      "skos:definition": "The failure mode in which a learned model fits its training data, including noise and quirks of the particular sample, more closely than the underlying data distribution, so that training error is low but error on new data is high; the gap between the two is the generalization gap.",
      "kto:domain": "ml-foundations",
      "dcterms:created": "2026-11-13",
      "kto:maturity": "foundational",
      "prov:wasDerivedFrom": [
