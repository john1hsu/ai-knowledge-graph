    {
      "@id": "kt:machine-learning",
      "@type": "kto:Field",
      "skos:prefLabel": "Machine learning",
      "skos:definition": "The subfield of artificial intelligence that studies computer programs which improve their performance at a task through experience, typically by fitting a model to data rather than being explicitly programmed with rules.",
