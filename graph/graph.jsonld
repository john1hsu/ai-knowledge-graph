      "@id": "kt:generative-adversarial-network",
      "@type": "kto:Architecture",
      "skos:prefLabel": "Generative adversarial network",
      "skos:definition": "A generative modelling framework in which two neural networks are trained against each other: a generator that maps random noise to synthetic samples, and a discriminator that tries to tell those samples apart from real training data, so that the generator gradually learns to produce data the discriminator cannot distinguish.",
      "kto:domain": "computer-vision-and-multimodal",
      "dcterms:created": "2026-10-30",
      "kto:maturity": "established",
      "prov:wasDerivedFrom": [
