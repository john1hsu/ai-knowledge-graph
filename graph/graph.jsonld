    {
      "@id": "kt:generative-adversarial-network",
      "@type": "kto:Architecture",
      "skos:prefLabel": "Generative adversarial network",
      "skos:definition": "A generative modelling framework in which two neural networks are trained against each other: a generator that maps random noise to synthetic samples, and a discriminator that tries to tell those samples apart from real training data, so that the generator gradually learns to produce data the discriminator cannot distinguish.",
      "kto:domain": "computer-vision-and-multimodal",
      "dcterms:created": "2026-10-30",
      "kto:maturity": "established",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Generative Adversarial Nets",
          "dcterms:publisher": "NeurIPS 2014, Advances in Neural Information Processing Systems 27 (Goodfellow et al.)",
          "schema:url": "https://proceedings.neurips.cc/paper/5423-generative-adversarial-nets",
          "kto:sourceType": "peer-reviewed"
        },
        {
          "dcterms:title": "Unsupervised Representation Learning with Deep Convolutional Generative Adversarial Networks",
          "dcterms:publisher": "arXiv 1511.06434 (Radford, Metz and Chintala)",
          "schema:url": "https://arxiv.org/abs/1511.06434",
          "kto:sourceType": "primary"
        },
        {
          "dcterms:title": "Wasserstein Generative Adversarial Networks",
          "dcterms:publisher": "Proceedings of ICML 2017, PMLR 70:214–223 (Arjovsky, Chintala and Bottou)",
          "schema:url": "https://proceedings.mlr.press/v70/arjovsky17a.html",
          "kto:sourceType": "peer-reviewed"
        },
        {
